{
  "manifest_version": 3,
  "name": "SecureWebOps Scanner",
  "description": "Quick website scan launcher powered by SecureWebOps.",
  "version": "1.2",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "http://localhost:8080/*",
    "http://localhost:3000/*",
    "https://securewebops.gannon.link/*",
    "https://api.securewebops.gannon.link/*",
    "https://culznwivxwtvrmohstht.supabase.co/*",
    "http://172.20.0.220:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["rules.js", "phishingMailboxContent.js"],
      "css": ["phishingStyles.css"],
      "run_at": "document_idle"
    }
  ]
}
